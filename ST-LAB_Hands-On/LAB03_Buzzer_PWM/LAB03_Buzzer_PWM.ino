  - กรุณาแก้ค่า WiFi / Broker / Server ให้ตรงกับหน้างานก่อนใช้งานจริง  // คำสั่ง/การตั้งค่าในโปรแกรม
  - ผังขา (GPIO) ยึดตามสเปกที่ล็อกไว้ในเอกสารประกอบการสอน  // คำสั่ง/การตั้งค่าในโปรแกรม
*/


#define BUZZER_PIN 5   // ตามที่ยืนยัน: ย้าย Buzzer ไป GPIO5

// ESP32 ใช้ LEDC (PWM) สำหรับสร้างความถี่เสียง
const int PWM_CH = 0;  // ประกาศค่าคงที่สำหรับการตั้งค่า
const int PWM_RES = 8;        // 0..255
const int PWM_DUTY = 128;     // 50%

void setup() {  // ฟังก์ชันเริ่มต้น ทำงานครั้งเดียวเมื่อบอร์ดเริ่มทำงาน
  Serial.begin(115200);  // เริ่มต้นพอร์ต Serial สำหรับดีบัก
  ledcSetup(PWM_CH, 2000, PWM_RES);   // เริ่มที่ 2 kHz
  ledcAttachPin(BUZZER_PIN, PWM_CH);  // ผูกขา GPIO เข้ากับช่อง PWM
  Serial.println("LAB03: Buzzer PWM Started");  // คำสั่ง/การตั้งค่าในโปรแกรม
}  // ขอบเขตบล็อกคำสั่ง

void beep(int freq, int ms) {  // คำสั่ง/การตั้งค่าในโปรแกรม
  ledcWriteTone(PWM_CH, freq);  // กำหนดความถี่เสียง/สัญญาณ PWM
  ledcWrite(PWM_CH, PWM_DUTY);  // กำหนด duty cycle ของ PWM
  delay(ms);  // หน่วงเวลา (มิลลิวินาที)
  ledcWrite(PWM_CH, 0);  // ปิดเสียง
}  // ขอบเขตบล็อกคำสั่ง

void loop() {  // ฟังก์ชันหลัก ทำงานวนซ้ำตลอดเวลา
  // ไล่โน้ตแบบง่าย ๆ
  beep(880, 120);  // คำสั่ง/การตั้งค่าในโปรแกรม
  beep(988, 120);  // คำสั่ง/การตั้งค่าในโปรแกรม
  beep(1047, 120);  // คำสั่ง/การตั้งค่าในโปรแกรม
  delay(500);  // หน่วงเวลา (มิลลิวินาที)
}  // ขอบเขตบล็อกคำสั่ง

/*
  ST-LAB v2.0 (ESP32) - Example Code (Thai Commented)  // คำสั่ง/การตั้งค่าในโปรแกรม
  หมายเหตุ:  // คำสั่ง/การตั้งค่าในโปรแกรม
  - กรุณาแก้ค่า WiFi / Broker / Server ให้ตรงกับหน้างานก่อนใช้งานจริง  // คำสั่ง/การตั้งค่าในโปรแกรม
  - ผังขา (GPIO) ยึดตามสเปกที่ล็อกไว้ในเอกสารประกอบการสอน  // คำสั่ง/การตั้งค่าในโปรแกรม
*/


#include <Wire.h>  // เรียกใช้งานไลบรารีที่จำเป็น
#include <LiquidCrystal_I2C.h>  // เรียกใช้งานไลบรารีที่จำเป็น

#define I2C_SDA 21  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก
#define I2C_SCL 22  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก
#define LCD_ADDR 0x27  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก

LiquidCrystal_I2C lcd(LCD_ADDR, 16, 2);  // คำสั่ง/การตั้งค่าในโปรแกรม

void setup() {  // ฟังก์ชันเริ่มต้น ทำงานครั้งเดียวเมื่อบอร์ดเริ่มทำงาน
  Wire.begin(I2C_SDA, I2C_SCL);  // เริ่มต้นบัส I2C ด้วยขา SDA/SCL ที่กำหนด
  lcd.init();  // สั่งงานจอ LCD ผ่านไลบรารี
  lcd.backlight();  // สั่งงานจอ LCD ผ่านไลบรารี

  lcd.setCursor(0, 0);  // สั่งงานจอ LCD ผ่านไลบรารี
  lcd.print("ST-LAB v2.0");  // สั่งงานจอ LCD ผ่านไลบรารี
  lcd.setCursor(0, 1);  // สั่งงานจอ LCD ผ่านไลบรารี
  lcd.print("I2C LCD 0x27");  // สั่งงานจอ LCD ผ่านไลบรารี
}  // ขอบเขตบล็อกคำสั่ง

void loop() {  // ฟังก์ชันหลัก ทำงานวนซ้ำตลอดเวลา
  static int n = 0;  // คำสั่ง/การตั้งค่าในโปรแกรม
  lcd.setCursor(14, 1);  // สั่งงานจอ LCD ผ่านไลบรารี
  lcd.print((n / 10) % 10);  // สั่งงานจอ LCD ผ่านไลบรารี
  lcd.print(n % 10);  // สั่งงานจอ LCD ผ่านไลบรารี
  n = (n + 1) % 100;  // คำสั่ง/การตั้งค่าในโปรแกรม
  delay(250);  // หน่วงเวลา (มิลลิวินาที)
}  // ขอบเขตบล็อกคำสั่ง

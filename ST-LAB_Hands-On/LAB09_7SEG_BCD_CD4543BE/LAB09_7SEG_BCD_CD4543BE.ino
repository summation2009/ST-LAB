// -------------------------------------------------------------
// ST-LAB v2.0 - 7-Segment 2 Digit (BCD -> CD4543BE x2)
// BCD (8-4-2-1): A=1, B=2, C=4, D=8
// -------------------------------------------------------------

#define TENS_A 16  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก
#define TENS_B 17  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก
#define TENS_C 18  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก
#define TENS_D 19  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก

#define UNITS_A 12  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก
#define UNITS_B 32  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก
#define UNITS_C 25  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก
#define UNITS_D 27  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก

void writeBCD(int pinA, int pinB, int pinC, int pinD, int n) {  // คำสั่ง/การตั้งค่าในโปรแกรม
  n = constrain(n, 0, 9);  // คำสั่ง/การตั้งค่าในโปรแกรม
  digitalWrite(pinA, (n >> 0) & 0x01);  // สั่งให้ขา GPIO ออกค่า HIGH/LOW
  digitalWrite(pinB, (n >> 1) & 0x01);  // สั่งให้ขา GPIO ออกค่า HIGH/LOW
  digitalWrite(pinC, (n >> 2) & 0x01);  // สั่งให้ขา GPIO ออกค่า HIGH/LOW
  digitalWrite(pinD, (n >> 3) & 0x01);  // สั่งให้ขา GPIO ออกค่า HIGH/LOW
}  // ขอบเขตบล็อกคำสั่ง

void show2DigitNumber(int value) {  // คำสั่ง/การตั้งค่าในโปรแกรม
  value = constrain(value, 0, 99);  // คำสั่ง/การตั้งค่าในโปรแกรม
  int tens  = value / 10;  // คำสั่ง/การตั้งค่าในโปรแกรม
  int units = value % 10;  // คำสั่ง/การตั้งค่าในโปรแกรม

  writeBCD(TENS_A, TENS_B, TENS_C, TENS_D, tens);  // คำสั่ง/การตั้งค่าในโปรแกรม
  writeBCD(UNITS_A, UNITS_B, UNITS_C, UNITS_D, units);  // คำสั่ง/การตั้งค่าในโปรแกรม
}  // ขอบเขตบล็อกคำสั่ง

void setup() {  // ฟังก์ชันเริ่มต้น ทำงานครั้งเดียวเมื่อบอร์ดเริ่มทำงาน
  pinMode(TENS_A, OUTPUT);  // กำหนดโหมดการทำงานของขา GPIO
  pinMode(TENS_B, OUTPUT);  // กำหนดโหมดการทำงานของขา GPIO
  pinMode(TENS_C, OUTPUT);  // กำหนดโหมดการทำงานของขา GPIO
  pinMode(TENS_D, OUTPUT);  // กำหนดโหมดการทำงานของขา GPIO

  pinMode(UNITS_A, OUTPUT);  // กำหนดโหมดการทำงานของขา GPIO
  pinMode(UNITS_B, OUTPUT);  // กำหนดโหมดการทำงานของขา GPIO
  pinMode(UNITS_C, OUTPUT);  // กำหนดโหมดการทำงานของขา GPIO
  pinMode(UNITS_D, OUTPUT);  // กำหนดโหมดการทำงานของขา GPIO

  show2DigitNumber(0);  // คำสั่ง/การตั้งค่าในโปรแกรม
}  // ขอบเขตบล็อกคำสั่ง

void loop() {  // ฟังก์ชันหลัก ทำงานวนซ้ำตลอดเวลา
  static int n = 0;  // คำสั่ง/การตั้งค่าในโปรแกรม
  show2DigitNumber(n);  // คำสั่ง/การตั้งค่าในโปรแกรม
  n = (n + 1) % 100;  // คำสั่ง/การตั้งค่าในโปรแกรม
  delay(200);  // หน่วงเวลา (มิลลิวินาที)
}  // ขอบเขตบล็อกคำสั่ง

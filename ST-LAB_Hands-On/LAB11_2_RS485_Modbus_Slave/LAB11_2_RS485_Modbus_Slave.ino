  - กรุณาแก้ค่า WiFi / Broker / Server ให้ตรงกับหน้างานก่อนใช้งานจริง  // คำสั่ง/การตั้งค่าในโปรแกรม
  - ผังขา (GPIO) ยึดตามสเปกที่ล็อกไว้ในเอกสารประกอบการสอน  // คำสั่ง/การตั้งค่าในโปรแกรม
*/


#include <ModbusRTU.h>  // เรียกใช้งานไลบรารีที่จำเป็น
#include <DHT.h>  // เรียกใช้งานไลบรารีที่จำเป็น

#define RS485_RX 16  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก
#define RS485_TX 17  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก

#define POT_PIN 35  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก
#define DHT_PIN 32  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก
#define DHT_TYPE DHT11  // กำหนดค่าคงที่/ชื่อพินเพื่อใช้งานสะดวก

DHT dht(DHT_PIN, DHT_TYPE);  // คำสั่ง/การตั้งค่าในโปรแกรม
ModbusRTU mb;  // สั่งงาน/ตั้งค่าโปรโตคอล Modbus RTU

void setup() {  // ฟังก์ชันเริ่มต้น ทำงานครั้งเดียวเมื่อบอร์ดเริ่มทำงาน
  Serial.begin(115200);  // เริ่มต้นพอร์ต Serial สำหรับดีบัก

  analogReadResolution(12);  // ตั้งความละเอียด ADC ของ ESP32
  dht.begin();  // อ่านค่า/เริ่มต้นเซนเซอร์ DHT11

  Serial2.begin(9600, SERIAL_8N1, RS485_RX, RS485_TX);  // เริ่มต้น UART2 สำหรับสื่อสารอุปกรณ์ภายนอก

  mb.begin(&Serial2);  // สั่งงาน/ตั้งค่าโปรโตคอล Modbus RTU
  mb.slave(1);  // สั่งงาน/ตั้งค่าโปรโตคอล Modbus RTU

  mb.addHreg(0x0000, 0);  // สั่งงาน/ตั้งค่าโปรโตคอล Modbus RTU
  mb.addHreg(0x0001, 0);  // สั่งงาน/ตั้งค่าโปรโตคอล Modbus RTU

  Serial.println("LAB11.2: Modbus RTU Slave Started");  // สั่งงาน/ตั้งค่าโปรโตคอล Modbus RTU
}  // ขอบเขตบล็อกคำสั่ง

void loop() {  // ฟังก์ชันหลัก ทำงานวนซ้ำตลอดเวลา
  mb.Hreg(0x0000, analogRead(POT_PIN));  // อ่านค่าแอนะล็อก (ADC) จากขาที่กำหนด

  float t = dht.readTemperature();  // อ่านค่า/เริ่มต้นเซนเซอร์ DHT11
  if (!isnan(t)) {  // ตรวจสอบเงื่อนไขการทำงาน
    mb.Hreg(0x0001, (uint16_t)(t * 10.0f));  // สั่งงาน/ตั้งค่าโปรโตคอล Modbus RTU
  }  // ขอบเขตบล็อกคำสั่ง

  mb.task();  // สั่งงาน/ตั้งค่าโปรโตคอล Modbus RTU
  delay(10);  // หน่วงเวลา (มิลลิวินาที)
}  // ขอบเขตบล็อกคำสั่ง
